#!/usr/bin/env bash
# benchmark:init-run
# Open the GitHub issue for this machine: host details on top, an empty summary table, and a JSON
# fence for bots. Runs preflight first. Prints the issue number and URL on stdout. Runs no probes.
set -uo pipefail

CI_BENCH_HOME="${CI_BENCH_HOME:-/usr/local/lib/ci-bench}"
# shellcheck source=lib/common.sh
. "$CI_BENCH_HOME/lib/common.sh"
# shellcheck source=lib/host.sh
. "$CI_BENCH_HOME/lib/host.sh"

case "${1:-}" in
  '') ;;
  -h|--help) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "benchmark:init-run: unknown argument '$1'" >&2; exit 2 ;;
esac

ci_preflight --for init || exit 1
created="$(ci_issue_create)" || { echo "benchmark:init-run: could not create the issue" >&2; exit 1; }
number="$(jq -r .number <<<"$created")"
printf '#%s %s\n' "$number" "$(jq -r .url <<<"$created")"
# The next step, as a command to copy. The hint goes to stderr so stdout stays "#N URL".
{
  echo
  echo "Next, run the benchmarks and add the result to this issue:"
  echo
  echo "    ${CI_BENCH_REPO:+CI_BENCH_REPO=$CI_BENCH_REPO }benchmark:run --issue $number"
} >&2
